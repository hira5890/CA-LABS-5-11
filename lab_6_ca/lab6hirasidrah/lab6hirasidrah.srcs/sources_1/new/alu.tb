`timescale 1ns/1ps

module RISCVALU_tb_small;

// Inputs
reg [31:0] A, B;
reg [3:0] ALUctl;

// Outputs
wire [31:0] ALUout;
wire Zero;

// Instantiate the ALU
RISCVALU uut (
    .ALUctl(ALUctl),
    .A(A),
    .B(B),
    .ALUout(ALUout),
    .Zero(Zero)
);

initial begin

    // Initialize
    A = 0; 
    B = 0; 
    ALUctl = 0;
    #10;

    // -------------------------
    // AND: 2 & 3 = 2
    A = 32'd2; B = 32'd3; ALUctl = 4'b0000; #10;

    // OR: 2 | 3 = 3
    ALUctl = 4'b0001; #10;

    // ADD: 2 + 3 = 5
    ALUctl = 4'b0010; #10;

    // SUB: 3 - 2 = 1
    A = 32'd3; B = 32'd2; ALUctl = 4'b0110; #10;

    // SLT: 2 < 3 = 1
    A = 32'd2; B = 32'd3; ALUctl = 4'b0111; #10;

    // SLT: 3 < 2 = 0
    A = 32'd3; B = 32'd2; #10;

    // NOR: ~(2 | 3)
    A = 32'd2; B = 32'd3; ALUctl = 4'b1100; #10;

    // XOR: 2 ^ 3 = 1
    ALUctl = 4'b1010; #10;

    // -------------------------
    // SLL Tests
    // 2 << 1 = 4
    A = 32'd2; B = 32'd1; ALUctl = 4'b1000; #10;

    // 3 << 2 = 12
    A = 32'd3; B = 32'd2; #10;

    // -------------------------
    // SRL Tests
    // 8 >> 1 = 4
    A = 32'd8; B = 32'd1; ALUctl = 4'b1001; #10;

    // 16 >> 2 = 4
    A = 32'd16; B = 32'd2; #10;

    // -------------------------
    // Zero Flag Test (2 - 2 = 0)
    A = 32'd2; B = 32'd2; ALUctl = 4'b0110; #10;

    // -------------------------
    // DEFAULT case test
    // Undefined ALUctl (1111) ? ALUout should be 0
    A = 32'd10; B = 32'd5; ALUctl = 4'b1111; #10;

    $stop;   // Stop simulation

end

endmodule
